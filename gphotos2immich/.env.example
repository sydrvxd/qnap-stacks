# In Komodo unter Stack -> Environment eintragen, NICHT hier committen.
# Dieses Repo ist oeffentlich!

# Immich-API-Key braucht: asset.read, asset.upload, album.create, album.read,
# album.update, albumAsset.create, user.read  (oder schlicht "All").
# Liegt als Komodo-Secret-Variable, referenziert mit [[IMMICH_API_KEY]].
IMMICH_API_URL=http://192.168.1.100:2283/api
IMMICH_API_KEY=[[IMMICH_API_KEY]]

# Album-Liste als base64-kodierte config.json (Aufbau: config.example.json).
# Enthaelt die Share-Links und gehoert daher NICHT ins Repo.
# Erzeugen mit:  base64 -w0 < config.json
GPHOTOS_CONFIG_B64=[[GPHOTOS_CONFIG_B64]]
